// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(uuid())
  fullName          String
  email             String   @unique
  password          String
  birthDate         DateTime
  registry          String?  @unique
  position          String
  department        String
  role              Role     @default(USER)
  totalVacationDays Int      @default(0)
  totalTreDays      Int      @default(0)
  status            Status   @default(ACTIVE)

  vacation Vacation[]
  tre      Tre[]
  verificationTokens VerificationToken[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("users")
}

model Vacation {
  id                  String                 @id @default(uuid())
  userId              String                 @map("user_id")
  user                User                   @relation(fields: [userId], references: [id])
  firstVacationDay    DateTime
  lastVacationDay     DateTime
  vacationSeiNumber   String?
  requestType         VacationRequestType
  year                Int
  amoutOfVacationDays Int                    @default(0)
  observations        String?
  effectiveEnjoyment  EffectiveEnjoymentEnum @default(NO) @map("effective_enjoyment")
  creteadAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@map("vacations")
}

model Tre {
  id                 String                 @id @default(uuid())
  userId             String                 @map("user_Id")
  user               User                   @relation(fields: [userId], references: [id])
  firstTreDay        DateTime?
  lastTreDay         DateTime?
  treSeiNumber       String?
  requestType        TreRequestType
  yearOfAcquisition  Int
  amoutOfTreDays     Int                    @default(0)
  observations       String?
  effectiveEnjoyment EffectiveEnjoymentEnum @map("effective_enjoyment")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@map("tre")
}

model VerificationToken {
  id        String                @id @default(uuid())
  user      User                  @relation(fields: [userId], references: [id])
  userId    String
  token     String                @unique
  type      VerificationTokenType
  createAt  DateTime
  updatedAt DateTime?

  @@map("verification_tokens")
}

enum VerificationTokenType {
  RESET_PASSWORD
}


enum Role {
  USER
  ADMIN
  GESTOR
}

enum VacationRequestType {
  ALTERACAO_DE_GOZO
  PROGRAMACAO_DE_FERIAS
  SOLICITACAO_DE_GOZO
  SUSPENSAO_DE_GOZO
}

enum TreRequestType {
  INCLUIR_SALDO
  SOLICITACAO_DE_GOZO
  CANCELAMENTO_DE_GOZO
}

enum Status {
  ACTIVE
  INACTIVE
}

enum EffectiveEnjoymentEnum {
  PARTIAL
  YES
  NO
}
