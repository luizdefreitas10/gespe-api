# Gespe API - Variáveis de ambiente
# Copie para .env e preencha os valores

# === Banco de dados (Supabase PostgreSQL) ===
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Use o modo "Transaction" no Supabase Dashboard > Settings > Database > Connection string
# Adicione ?sslmode=require no final
DATABASE_URL="postgresql://postgres.xxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# === JWT (RS256) ===
# Gere com: openssl genrsa 2048 | base64 -w 0
JWT_PRIVATE_KEY="sua_chave_privada_base64"

# Gere com: openssl rsa -in priv.pem -pubout | base64 -w 0
JWT_PUBLIC_KEY="sua_chave_publica_base64"

# === Servidor ===
PORT=3333

# === CORS (opcional, separar por vírgula) ===
# Produção: https://seu-frontend.onrender.com
# Desenvolvimento: http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
