# Gespe API - Variáveis de ambiente
# Copie para .env e preencha os valores

# === Banco de dados (Supabase PostgreSQL) ===
#
# O Prisma usa duas URLs (veja prisma/schema.prisma): DATABASE_URL + DIRECT_URL.
#
# Caracteres especiais na SENHA: codifique na URL (RFC 3986), ex.: ! → %21, @ → %40
#
# --- Local (quando db.*.supabase.co responde na sua rede) ---
# Mesma URL nas duas variáveis:
#   DATABASE_URL/DIRECT_URL = postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
#
# --- Render / IPv4 (erro P1001 em db.*) — Supavisor no painel Supabase ---
# Usuário do pooler: postgres.SEU_REF (com ponto). Região em Project Settings → Database.
#
# DATABASE_URL = modo transação (app Prisma Client), porta 6543:
#   postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# DIRECT_URL = modo sessão (migrate deploy / introspect), porta 5432 no MESMO host pooler:
#   postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
#
DATABASE_URL="postgresql://postgres:SUA_SENHA_URL_ENCODED@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:SUA_SENHA_URL_ENCODED@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require"

# === JWT (RS256) ===
JWT_PRIVATE_KEY="sua_chave_privada_base64"
JWT_PUBLIC_KEY="sua_chave_publica_base64"

# === Servidor ===
PORT=3333

# === CORS (opcional, separar por vírgula) ===
CORS_ORIGIN="http://localhost:3000"

# === Seed de admin (uso pontual) ===
# Execute: npm run db:seed-admin
ADMIN_EMAIL="admin@gespe.local"
ADMIN_PASSWORD="12345678"
ADMIN_FULL_NAME="Administrador do Sistema"
ADMIN_POSITION="Administrador"
ADMIN_DEPARTMENT="TI"
ADMIN_BIRTH_DATE="1990-01-01"
