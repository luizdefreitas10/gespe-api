# Gespe API - Variáveis de ambiente
# Copie para .env e preencha os valores

# === Banco de dados (Supabase PostgreSQL) ===
#
# Recomendado para Prisma + `migrate deploy` (Render e local):
#   Conexão DIRETA (porta 5432), usuário `postgres` (sem .ref no user).
#   Sempre use ?sslmode=require
#
# Caracteres especiais na SENHA precisam ser codificados na URL (RFC 3986):
#   ! → %21    @ → %40    # → %23    $ → %24    % → %25    & → %26
#
# Exemplo (senha "MinhaSenha!"):
#   postgresql://postgres:MinhaSenha%21@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
#
# Pooler (6543) é útil para muitas conexões curtas; o Prisma Migrate costuma falhar
# ou dar "Tenant or user not found" se user/host do pooler estiverem incorretos.
DATABASE_URL="postgresql://postgres:SUA_SENHA_URL_ENCODED@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require"

# === JWT (RS256) ===
JWT_PRIVATE_KEY="sua_chave_privada_base64"
JWT_PUBLIC_KEY="sua_chave_publica_base64"

# === Servidor ===
PORT=3333

# === CORS (opcional, separar por vírgula) ===
CORS_ORIGIN="http://localhost:3000"
